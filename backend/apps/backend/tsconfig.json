{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    // Source imports carry explicit .ts extensions because `node --test
    // --experimental-strip-types` resolves ESM specifiers literally and will not find an
    // extensionless one. tsc emits those verbatim, so `require("./dispatch.ts")` reached the
    // build output and Medusa died on start: the artifact contains dispatch.js.
    // This rewrites .ts -> .js on emit, so both runtimes get the form they need.
    // Added 2026-08-25 after that outage. TypeScript 5.7+; this project is on 5.9.3.
    "rewriteRelativeImportExtensions": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "strictNullChecks": true
  },
  "ts-node": {
    "swc": true
  },
  "include": [
    "**/*",
    ".medusa/types/*"
  ],
  "exclude": [
    "node_modules",
    ".medusa/server",
    ".medusa/admin",
    ".cache",
    "eslint.config.*",
    // Tests are not application code and must never be compiled into .medusa/server.
    // Also a hard safety property: rebuild.sh runs with `set -e`, so ANY type error in a test
    // file would abort every deploy by every agent. Test code must not be able to do that.
    "**/*.test.ts",
    // A diagnostic CLI, not application code: it has top-level await, which a CommonJS build
    // rejects outright (TS1309). It is run by hand under `node --experimental-strip-types`,
    // and its own exit code is its check. It must not be able to abort a deploy.
    "src/modules/email/check-events.ts",
  ]
}
